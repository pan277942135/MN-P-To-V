# GEMINI_API_KEY: Required only for Google AI API-key based calls.
# Director Storyboard uses Vertex AI + Cloud Run runtime service account in UAT, so no browser API key is exposed.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VEO_OUTPUT_BUCKET: Google Cloud Storage bucket for Veo video artifacts
VEO_OUTPUT_BUCKET="ai-studio-bucket-89614354864-asia-south1"

# Director Storyboard Gemini configuration.
# UAT enables this explicitly in the Cloud Run deployment workflow.
DIRECTOR_STORYBOARD_GEMINI_ENABLED="0"
DIRECTOR_STORYBOARD_MODEL="gemini-2.5-flash"
DIRECTOR_STORYBOARD_LOCATION="us-central1"

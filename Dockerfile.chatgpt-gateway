FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN npm install --ignore-scripts
COPY tsconfig.json ./
COPY chatgpt-gateway.ts chatgpt-action-openapi.yaml ./
COPY src ./src
RUN npx esbuild chatgpt-gateway.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/chatgpt-gateway.cjs

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json ./
RUN npm install --omit=dev --ignore-scripts
COPY --from=build /app/dist/chatgpt-gateway.cjs ./dist/chatgpt-gateway.cjs
COPY chatgpt-action-openapi.yaml ./chatgpt-action-openapi.yaml
EXPOSE 8080
CMD ["node", "dist/chatgpt-gateway.cjs"]

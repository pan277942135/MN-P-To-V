FROM oven/bun:1.3.14 AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
RUN bunx esbuild chatgpt-gateway-v12.ts \
  --bundle \
  --platform=node \
  --format=cjs \
  --packages=external \
  --outfile=dist/chatgpt-gateway.cjs

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist/chatgpt-gateway.cjs ./dist/chatgpt-gateway.cjs
COPY --from=build /app/chatgpt-action-openapi.yaml ./chatgpt-action-openapi.yaml
USER node
EXPOSE 8080
CMD ["node", "dist/chatgpt-gateway.cjs"]
